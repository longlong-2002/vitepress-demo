{
  "name": "my-notes",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "description": "龙龙的技术日记 - 成长之路",
  "scripts": {
    "docs:dev": "cross-env NODE_ENV=development vitepress dev . --port 8732",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview . --port 8730",
    "lint": "prettier --write \"**/*.{js,ts,md,json,css,scss}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@giscus/vue": "^2.4.0",
    "@mdit-vue/shared": "^2.1.3",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "medium-zoom": "^1.1.0",
    "prettier": "^3.8.4",
    "sass": "^1.83.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.5.0",
    "vitepress-markdown-timeline": "^1.2.1",
    "vitepress-plugin-nprogress": "^0.0.4",
    "vue": "^3.5.35"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3"
  },
  "lint-staged": {
    "*.{js,ts,md,json,css,scss}": [
      "prettier --write"
    ]
  }
}
